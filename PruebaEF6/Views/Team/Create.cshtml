@model PruebaEF6.Models.Team
@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm("CreateTeam", "Team", FormMethod.Post))
{
    <div>
        <div class="mb-3">
            @Html.LabelFor(model => model.Name)
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.Label("CountrySelector", "Country", new { @class = "form-label" })
            @Html.DropDownList("CountrySelector", (IEnumerable<SelectListItem>)ViewBag.Countries, new { @class = "form-select", id = "CountrySelector" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.League_Id, "League", new { @class = "form-label" })
            @Html.DropDownListFor(model => model.League_Id, Enumerable.Empty<SelectListItem>(), new { @class = "form-select", id = "LeagueSelector" })
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
}

@section Scripts{
    <script src="~/Utils/updateLeagues.js"></script>

    <script>

        let urlGetLeagues = "@Url.Action("GetLeaguesByCountry","League")" + "?id=" + $("#CountrySelector").val()

        $(async function () {
            await updateLeagues(urlGetLeagues);
            $("#CountrySelector").change(async function () {
                urlGetLeagues = "@Url.Action("GetLeaguesByCountry","League")" + "?id=" + $("#CountrySelector").val()
                await updateLeagues(urlGetLeagues);
            });
        })
    </script>
}
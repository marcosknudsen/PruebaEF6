@model PruebaEF6.Models.Team
@{
    ViewBag.Title = "Edit";
}

<h2>Edit: Team</h2>

@using (Html.BeginForm("EditTeam", "Team", new { id = Model.Id }, FormMethod.Post))
{
    <div>
        <div class="mb-3">
            @Html.LabelFor(model => model.Name)
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            @Html.Label("Country", "Country", new { @class = "form-label" })
            @Html.DropDownList("Country", (IEnumerable<SelectListItem>)ViewBag.Countries, new { @class = "form-select", id = "CountrySelector" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.League_Id,"League",new { @class = "form-label" })
            @Html.DropDownListFor(model => model.League_Id, Enumerable.Empty<SelectListItem>(), new { @class = "form-select", id = "LeagueSelector" })
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
}

@section Scripts{
    <script src="~/Utils/updateLeagues.js"></script>

    <script>
            urlGetLeagues = "@Url.Action("GetLeaguesByCountry","League")"
        $(async function () {

            await updateLeagues();
            console.log("A")
            $("#CountrySelector").change(async function () {
                await updateLeagues();
            });

        })
    </script>
}